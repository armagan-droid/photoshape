    "review.revertHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The full frame is kept too. To get it back, open it in Photos and tap ⋯ > Revert to Original."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam kare de saklandı. Geri almak için Fotoğraflar'da aç, ⋯ > Özgüne Dön'e dokun."
          }
        }
      }
    },
    "save.denied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't save to your library. You can allow it in Settings > photoshape > Photos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraf galeriye kaydedilemedi. Ayarlar > photoshape > Fotoğraflar'dan izin verebilirsin."
