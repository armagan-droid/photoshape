        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beğendiğin bir fotoğrafı seç. Kamerayı ona benzer çekecek şekilde ayarlayayım."
          }
        }
      }
    },
    "reference.prompt.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What kind of photo do you want to take?"
