    "camera.denied.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow camera access in Settings to take photos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraf çekebilmek için Ayarlar'dan kameraya izin ver."
