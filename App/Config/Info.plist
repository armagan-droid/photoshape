<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Spec 07 Hikâye 1: asking whether Instagram is installed (Feed and Stories share URLs). -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>instagram</string>
		<string>instagram-stories</string>
	</array>
	<!-- Meta requires an app ID for sharing to Stories. Empty: the Story option is not offered (spec 07 FR-001). -->
	<key>FacebookAppID</key>
	<string>$(FACEBOOK_APP_ID)</string>
	<!-- Spec 07b: whether the quota and paywall are on (v1: NO). -->
	<key>PhotoshapePaywall</key>
	<string>$(PAYWALL_ENABLED)</string>
	<key>PhotoshapePrivacyPolicyURL</key>
	<string>$(PRIVACY_POLICY_URL)</string>
</dict>
</plist>
